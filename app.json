{
  "expo": {
    "name": "CORTEX FIBER",
    "slug": "cortex-fiber-client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cortexfiber",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CORTEX FIBER utilise votre position pour vérifier l'éligibilité fibre à votre adresse."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF7900",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FF7900"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CORTEX FIBER utilise votre position pour vérifier l'éligibilité fibre à votre adresse."
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
